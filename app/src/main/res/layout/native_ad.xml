<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp">

    <!-- Icono de la app/anuncio -->
    <ImageView
        android:id="@+id/ad_app_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/ad_icon_desc"
        android:scaleType="fitCenter" />

    <!-- Textos e insignias -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Fila con distintivo de anuncio y titular -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad_badge"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/badge_ad"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Contenedor del icono de AdChoices que rellena Wortise -->
            <FrameLayout
                android:id="@+id/ad_choices"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- Anunciante o cuerpo -->
        <TextView
            android:id="@+id/ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

        <TextView
            android:id="@+id/ad_advertiser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Botón CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/ad_call_to_action"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:minHeight="30dp"
        android:layout_marginStart="6dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textSize="10sp"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/primary"
        app:cornerRadius="6dp" />
</LinearLayout>
