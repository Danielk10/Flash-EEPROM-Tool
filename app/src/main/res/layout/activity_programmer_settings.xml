<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/str_seleccionar_dis"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerProgrammer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark"
            android:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/str_ajustes_manuale"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etProgrammerParam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="Ej: ch341a_spi o ft2232_spi:type=2232H"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSaveProgrammer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/str_guardar_configu"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/str_hardware_soport"
            android:textColor="#388E3C"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSupported"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/str_asm106x_atavia_"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/str_hardware_no_sop"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvUnsupported"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/str_atahpt_atapromi"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
