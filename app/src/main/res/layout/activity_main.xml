<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F111A"
    android:padding="16dp">

    <!-- Indicador de Carga Inicial -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/str_preparando_depe"
            android:textColor="#E0E0E0"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- UI Principal -->
    <LinearLayout
        android:id="@+id/layoutMainUI"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/adContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/str_estado_usb_desc"
                    android:textColor="#4CAF50"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    app:backgroundTint="@color/btn_tint_blue"
                    android:textColor="@color/btn_text_color"
                    android:text="@string/str_detectar_y_cone"
                    android:layout_marginBottom="3dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/btnProbe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:minHeight="38dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        app:backgroundTint="@color/btn_tint_teal"
                        android:textColor="@color/btn_text_color"
                        android:text="@string/str_identificar_chi" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btnVerify"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:minHeight="38dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        app:backgroundTint="@color/btn_tint_purple"
                        android:textColor="@color/btn_text_color"
                        android:text="@string/str_verificar_rom" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/btnRead"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        app:backgroundTint="@color/btn_tint_green"
                        android:textColor="@color/btn_text_color"
                        android:textSize="14sp"
                        android:text="@string/str_leer_backup" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btnWrite"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        app:backgroundTint="@color/btn_tint_red"
                        android:textColor="@color/btn_text_color"
                        android:textSize="14sp"
                        android:text="@string/str_flashear_rom" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/btnImport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_weight="1"
                        app:backgroundTint="@color/btn_tint_grey"
                        android:textColor="@color/btn_text_color"
                        android:textSize="14sp"
                        android:text="@string/str_cargar_rom" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btnExport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_weight="1"
                        app:backgroundTint="@color/btn_tint_grey"
                        android:textColor="@color/btn_text_color"
                        android:textSize="14sp"
                        android:text="@string/str_guardar_rom" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/btnEraseChip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="38dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:enabled="false"
                        android:text="@string/str_borrar_chip"
                        app:backgroundTint="@color/btn_tint_orange"
                        android:textColor="@color/btn_text_color" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btnQuickClear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="38dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="@string/str_borrar_rom"
                        app:backgroundTint="@color/btn_tint_grey"
                        android:textColor="@color/btn_text_color" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etCustomCommand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/str_hint_comando"
                    android:inputType="text"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:background="#1B1E2B"
                    android:padding="6dp"
                    android:textColorHint="#757575"
                    android:textColor="#4DB6AC"
                    android:layout_marginBottom="3dp" />

                <CheckBox
                    android:id="@+id/cbVerifyWrite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Verificar escritura (Recomendado)"
                    android:textColor="#E0E0E0"
                    android:checked="true"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnRunCustomCommand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="@string/str_ejecutar_instru"
                    app:backgroundTint="@color/btn_tint_blue"
                    android:textColor="@color/btn_text_color"
                    android:layout_marginBottom="4dp" />
                    
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOperationStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/str_terminal_salida"
                    android:textColor="#B0BEC5"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_gravity="center_vertical"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <Button
                    android:id="@+id/btnAbort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_detener"
                    android:textColor="@color/btn_text_color"
                    app:backgroundTint="@color/btn_tint_darkred"
                    android:minHeight="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnClearLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_limpiar"
                    android:minHeight="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Terminal de Logs -->
        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:background="#0A0E17"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:lineSpacingExtra="3dp"
                android:longClickable="true"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:text="@string/str__log_" />

        </ScrollView>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
